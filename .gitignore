# Small evidence files are committed so the report, README and Colab demo work.
# Figures and sample text are small, so everything in them is allowed.
# Logs: ignore by default, then allow only the small result files.
outputs/logs/*
!outputs/logs/.gitkeep
!outputs/logs/ablation_results.csv
!outputs/logs/ablation_results.md
!outputs/logs/m5_training_summary.json
